//This is a button calender that will open an area for the user to input information and it will save that information there.

'use client';

import { useState } from 'react';

export default function CalendarPage() {
  const [selectedDate, setSelectedDate] = useState(null);
  const [inputValue, setInputValue] = useState('');
  const [calendarData, setCalendarData] = useState({}); // Stores local date-to-content mappings
  const [statusMessage, setStatusMessage] = useState('');

  // 1. Generate an array representing days of the current month
  const totalDaysInMonth = 31; 
  const daysArray = Array.from({ length: totalDaysInMonth }, (_, i) => i + 1);
  const currentMonthYear = "2026-10"; // Base date string format

  // 2. Fetch stored items for a specific date from the Java backend
  const fetchDateData = async (dateStr) => {
    try {
      const response = await fetch(`http://localhost:8080/api/items/${dateStr}`);
      if (response.ok) {
        const data = await response.json();
        // Update local state for just this date
        setCalendarData(prev => ({ ...prev, [dateStr]: data }));
      }
    } catch (error) {
      console.error('Error fetching date data:', error);
    }
  };

  // 3. Handle when a user clicks a button on a specific date
  const handleOpenDatePanel = (day) => {
    const dateStr = `${currentMonthYear}-${String(day).padStart(2, '0')}`;
    setSelectedDate(dateStr);
    setStatusMessage('');
    setInputValue('');
    fetchDateData(dateStr);
  };

  // 4. Save input text tied to the selected date
  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!inputValue.trim() || !selectedDate) return;

    try {
      const response = await fetch('http://localhost:8080/api/items', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          date: selectedDate, 
          content: inputValue 
        })
      });

      if (response.ok) {
        setStatusMessage('Saved!');
        setInputValue('');
        fetchDateData(selectedDate); // Refresh notes for this date
      } else {
        setStatusMessage('Failed to save.');
      }
    } catch (error) {
      console.error('Error saving data:', error);
      setStatusMessage('Error connecting to server.');
    }
  };

  return (
    <div style={{ padding: '20px', fontFamily: 'sans-serif', maxWidth: '800px', margin: '0 auto' }}>
      <h1>October 2026 Calendar</h1>
      
      {/* Calendar Grid View */}
      <div style={{ 
        display: 'grid', 
        gridTemplateColumns: 'repeat(7, 1fr)', 
        gap: '10px', 
        marginBottom: '30px' 
      }}>
        {daysArray.map((day) => {
          const dateStr = `${currentMonthYear}-${String(day).padStart(2, '0')}`;
          const hasNotes = calendarData[dateStr] && calendarData[dateStr].length > 0;

          return (
            <div 
              key={day} 
              style={{ 
                border: '1px solid #ddd', 
                borderRadius: '6px', 
                padding: '10px', 
                minHeight: '90px',
                backgroundColor: selectedDate === dateStr ? '#e6f7ff' : '#fff',
                display: 'flex',
                flexDirection: 'column',
                justifyContent: 'space-between'
              }}
            >
              <span style={{ fontWeight: 'bold' }}>{day}</span>
              
              {/* Visual Indicator if data already exists for this day */}
              {hasNotes && <div style={{ fontSize: '10px', color: '#28a745' }}>● Has info</div>}
              
              <button 
                onClick={() => handleOpenDatePanel(day)}
                style={{ 
                  marginTop: '5px', 
                  padding: '4px 8px', 
                  fontSize: '11px', 
                  backgroundColor: '#0070f3', 
                  color: 'white', 
                  border: 'none', 
                  borderRadius: '3px', 
                  cursor: 'pointer' 
                }}
              >
                Manage
              </button>
            </div>
          );
        })}
      </div>

      {/* Side/Bottom Input Panel for the chosen calendar date */}
      {selectedDate && (
        <div style={{ padding: '20px', border: '1px solid #b3d8ff', borderRadius: '8px', backgroundColor: '#f0f8ff' }}>
          <h3>Managing Information for: {selectedDate}</h3>
          
          <form onSubmit={handleSubmit} style={{ display: 'flex', gap: '10px', marginBottom: '15px' }}>
            <input 
              type="text" 
              value={inputValue}
              onChange={(e) => setInputValue(e.target.value)}
              placeholder="Type info for this day..."
              style={{ flex: 1, padding: '10px', borderRadius: '4px', border: '1px solid #ccc' }}
            />
            <button type="submit" style={{ padding: '10px 15px', backgroundColor: '#28a745', color: 'white', border: 'none', borderRadius: '4px', cursor: 'pointer' }}>
              Save Info
            </button>
          </form>
          {statusMessage && <p style={{ fontSize: '12px', color: 'green' }}>{statusMessage}</p>}

          <h5>Saved Items for this Day:</h5>
          <ul>
            {(calendarData[selectedDate] || []).map((item, index) => (
              <li key={index}>{item.content}</li>
            ))}
          </ul>
          <button onClick={() => setSelectedDate(null)} style={{ marginTop: '10px', fontSize: '12px', color: '#ff4d4f', border: 'none', background: 'none', cursor: 'pointer' }}>Close Panel</button>
        </div>
      )}
    </div>
  );
}

